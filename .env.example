# Copy to `.env.local` and fill in values. Never commit real secrets.

# Convex (often set automatically by `pnpm dlx convex dev`)
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# Optional — product name shown on login/signup (defaults to "My App")
VITE_APP_NAME=My App

# Optional — show social / SSO buttons when set to "true"
# VITE_GOOGLE_AUTH_ENABLED=true
# VITE_MICROSOFT_AUTH_ENABLED=true
# VITE_APPLE_AUTH_ENABLED=true
# VITE_GITHUB_AUTH_ENABLED=true
# VITE_SSO_ENABLED=true
